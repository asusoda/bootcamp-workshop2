{
  "name": "SoDA Hackathon Starter",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "App", "onAutoForward": "openPreview" } },
  "secrets": {
    "TINYFISH_API_KEY": { "description": "Your TinyFish API key from agent.tinyfish.ai/api-keys" }
  },
  "customizations": {
    "vscode": { "extensions": ["GitHub.copilot", "GitHub.copilot-chat"] }
  }
}
